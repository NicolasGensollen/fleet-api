# Ce fichier a deux effets, tous deux importants.
#
#  1. Il réduit le contexte de build envoyé au démon : moins de données à
#     transférer, build plus rapide.
#  2. Il évite que des fichiers locaux n'entrent dans l'image — et surtout que
#     `.venv`, construit pour VOTRE machine, n'écrase celui de l'étage builder.
#     C'est la recommandation explicite de la documentation uv.

# Environnement virtuel local — le plus important de la liste
.venv/
venv/

# Contrôle de version et CI
.git/
.github/
.gitignore

# Caches Python et outils
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Tests et matériel pédagogique : inutiles dans une image de production
tests/
.solution/
atelier-debug/

# Docker lui-même
Dockerfile*
compose*.yaml
.dockerignore

# Divers
*.md
!README.md
.env
*.db
.DS_Store
